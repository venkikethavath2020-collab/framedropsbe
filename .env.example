# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed by the CORS allowlist function in
# server.js. In production, set to ONLY your live domain(s) — do NOT include
# localhost or preview URLs. Replaces the legacy single-origin CORS_ORIGIN
# variable, which is no longer read by the code.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate limiting ────────────────────────────────────────────────────────────
# By default rate limiting is enabled in production and disabled elsewhere.
# Override here per environment.
#
# RATE_LIMIT_ENABLED      — 'true' | 'false'. Defaults to (NODE_ENV === 'production').
# RATE_LIMIT_API_MAX      — general /v1/* limit per 15 min per IP. Default 500.
# RATE_LIMIT_ADMIN_MAX    — /v1/admin/* limit per 15 min per IP. Default 1500.
# RATE_LIMIT_AUTH_MAX     — /v1/auth/* limit per 15 min per IP. Default 15
#                           (DO NOT raise without thinking — this is anti-brute-force).
# RATE_LIMIT_PAYMENT_MAX  — /v1/payments/* limit per 15 min per IP. Default 30.
# RATE_LIMIT_ENABLED=
# RATE_LIMIT_API_MAX=500
# RATE_LIMIT_ADMIN_MAX=1500
# RATE_LIMIT_AUTH_MAX=15
# RATE_LIMIT_PAYMENT_MAX=30

# ─── API Documentation (Swagger / OpenAPI) ────────────────────────────────────
# When true (default), serves Swagger UI at /api/docs and the raw spec at
# /api/docs.json. Set to false to disable in any environment.
SWAGGER_ENABLED=true
# Optional — overrides the "current" server entry in the spec. Useful when the
# API is fronted by a load balancer / reverse proxy and the host the browser
# sees differs from PORT-on-localhost. Falls back to http://localhost:$PORT.
PUBLIC_API_URL=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Option 1: Connection string (preferred — works with Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/framedrops


PG_POOL_MAX=50

# ─── Cloudflare R2 (object storage) ───────────────────────────────────────────
# Three buckets total (prod / staging / dev) — each environment ships its own
# scoped Access Key so a compromise of staging cannot reach prod.
#
# R2_ACCOUNT_ID    Cloudflare account id (find in dashboard URL)
# R2_BUCKET        bucket name (e.g. framedropstorage-prod | -staging | -dev)
# R2_PUBLIC_HOST   custom-domain hostname bound to the bucket
#                  (e.g. cdn.framedrops.in). Public URLs and Image Resizing
#                  thumb URLs are built off this host.
# R2_ENDPOINT      optional — full S3 endpoint override. When unset, derived
#                  as https://<account>.r2.cloudflarestorage.com.
# R2_IMAGE_RESIZE  optional — 'on' to build thumbnails via Cloudflare Image
#                  Resizing (/cdn-cgi/image/.../). Requires a Cloudflare Images
#                  plan with transformation quota; the free tier (5,000/month)
#                  exhausts and returns error 9422 (broken thumbnails). Default
#                  (unset/off) serves the raw, already-compressed R2 object.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=
# R2_ENDPOINT=
# R2_IMAGE_RESIZE=off

# ─── R2 cron workers ──────────────────────────────────────────────────────────
# Orphan reaper — weekly Sunday 04:00 UTC. Lists each recently-active
# album's R2 prefix, deletes objects not present in photos.storage_key.
# Bounded by ALBUM_MIN_AGE_DAYS so an in-flight upload is never reaped
# (presign TTL is 5 min, so 7 days is comfortable).
R2_REAPER_CRON=0 4 * * 0
R2_REAPER_DISABLED=false
R2_REAPER_ALBUM_BATCH=50
R2_REAPER_ALBUM_MIN_AGE_DAYS=7
R2_REAPER_RECLEAN_AGE_DAYS=30

# Reconciliation — weekly Sunday 05:00 UTC. Samples SAMPLE_PCT % of r2
# photo rows and HEADs each one. Logs (ERROR-level) when the sample miss
# rate exceeds 0.1% — wire your log aggregator to alert on that line.
R2_RECON_CRON=0 5 * * 0
R2_RECON_DISABLED=false
R2_RECON_SAMPLE_PCT=1
R2_RECON_MAX_ROWS=5000

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10

# ─── Email (transactional: OTP, invoices, notifications) ──────────────────────
# All email is delivered via the durable queue in src/email/ (table email_jobs).
# Set SMTP_ENABLED=false to skip real delivery and just log to stdout (dev mode).
# Bavo SMTP (works for low volume, requires an App Password):
SMTP_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@smtp-brevo.com
SMTP_PASS=xsmtpsib-REPLACE_WITH_YOUR_BREVO_SMTP_PASSWORD
SMTP_FROM=Framedrops <support@framedrops.in>


# Brand identity surfaced in emails, invoice PDFs, and server boot log.
# Override per-environment when needed (e.g. white-label tenant).
BRAND_NAME=Framedrops
BRAND_TAGLINE=Galleries for photographers

# Public URL of the photographer dashboard / customer gallery — used to build
# CTA links inside outgoing emails. Falls back to the first ALLOWED_ORIGINS entry.
APP_BASE_URL=http://localhost:5173

# Application-layer OTP rate cap (per recipient). Sits on top of the IP-based
# authLimiter in server.js. 5 OTP emails / 10 min per address by default.
EMAIL_OTP_RATE_LIMIT_PER_EMAIL=5
EMAIL_OTP_RATE_LIMIT_WINDOW_MIN=10

# Email worker — polls email_jobs and ships pending rows through nodemailer.
EMAIL_WORKER_DISABLED=false
EMAIL_WORKER_CRON=*/30 * * * * *
EMAIL_WORKER_BATCH=25

# Calendar reminder worker — sends reminder emails ahead of event start_time.
# Default = every minute. Disable in dev when you don't want it running.
CALENDAR_REMINDER_WORKER_DISABLED=false
CALENDAR_REMINDER_CRON=*/1 * * * *
CALENDAR_REMINDER_BATCH=50

# In-app /support form delivers here. Falls back to SUPPORT_EMAIL, then a
# hardcoded default. Pre-revenue, point both at one Gmail.
SUPPORT_INBOX_EMAIL=supportframedrops@gmail.com
SUPPORT_EMAIL=supportframedrops@gmail.com
SUPPORT_RATE_LIMIT_PER_USER=10
SUPPORT_RATE_LIMIT_WINDOW_MIN=60

# Allowlisted admin identity for /v1/auth/admin (email-code login). Both
# email + phone must match what's submitted to /admin/login or the request
# silently no-ops. First successful verify promotes / creates the users row.
ADMIN_EMAIL=
ADMIN_PHONE=

# ─── File Uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=25

# ─── Album Expiry ──────────────────────────────────────────────────────────────
# Number of days after album creation before the gallery link expires (0 = never)
ALBUM_EXPIRY_DAYS=30

# Paid extension parameters — photographer pays to extend an album's lifetime.
# Each successful payment bumps `expires_at` by ALBUM_EXTENSION_DAYS and resets
# is_expired. Charged at ALBUM_EXTENSION_PRICE_RUPEES (rupees, integer).
ALBUM_EXTENSION_DAYS=30
ALBUM_EXTENSION_PRICE_RUPEES=49

# Pre-expiry email reminder fires when an album has this many days left.
ALBUM_EXPIRY_REMINDER_DAYS=7

# Cron schedule for the expiry / R2-cleanup worker (default: every 6h).
ALBUM_EXPIRY_CRON=0 */6 * * *
# Set to "true" to disable the worker (e.g. on dev / one-off CLI processes).
ALBUM_EXPIRY_WORKER_DISABLED=false
# Tuning knobs for the worker. Defaults are usually fine.
ALBUM_EXPIRY_BATCH=200
ALBUM_CLEANUP_BATCH=50
ALBUM_CLEANUP_MAX_ATTEMPTS=5

# ─── Phone OTP ─ NOT WIRED ──────────────────────────────────────────────────
# Phone-OTP / SMS delivery is NOT implemented in the current codebase. The
# shipped product uses email-only OTP via Brevo (see SMTP + EMAIL_OTP_*
# settings above). Do NOT add OTP_PROVIDER / MOCK_OTP_CODE / MSG91_* /
# TWILIO_* / FIREBASE_* variables here — they have zero callers in src/ and
# the production boot guard (server.js) will fatal-exit if MOCK_OTP_CODE or
# OTP_PROVIDER=mock leaks into a production environment.
# Restore these settings if/when a real SMS provider is wired up.

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Use TEST keys for development: https://dashboard.razorpay.com/app/keys
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=

# ─── Wallet / Platform Fee ───────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=10

# ─── Withdrawals ─────────────────────────────────────────────────────────────
# Minimum withdrawal amount. Prefer MIN_WITHDRAWAL_RUPEES; MIN_WITHDRAWAL_PAISE
# overrides it when set.
MIN_WITHDRAWAL_RUPEES=1000
# MIN_WITHDRAWAL_PAISE=100000
# Optional per-request cap. Leave unset for no cap.
# MAX_WITHDRAWAL_RUPEES=100000
# MAX_WITHDRAWAL_PAISE=10000000

# ─── Cloudflare Turnstile (signup / login / OTP captcha) ──────────────────────
# Bot protection on identity-creating endpoints. The frontend renders the
# widget with VITE_TURNSTILE_SITE_KEY; the backend validates the token here.
#
# Provision in Cloudflare dashboard → Turnstile → Add site:
#   Domain:     framedrops.in (and localhost for dev)
#   Widget mode: Managed (auto-adjusts difficulty per visitor)
# You'll get a Site Key (public, ships in the FE bundle) and a Secret (here).
#
# Leave TURNSTILE_SECRET unset in dev to bypass captcha — middleware will log
# a warning at startup and let requests through. Required in production.
TURNSTILE_SECRET=

# ─── Sentry error tracking ────────────────────────────────────────────────────
# Server-side error sink. Only captures 5xx — 4xx are expected control flow.
# Provision in Sentry → Create project → Node.js, copy the DSN.
# Leave unset (or empty) to disable; the SDK init is skipped entirely.
SENTRY_DSN=

# ─── Lifecycle email worker ───────────────────────────────────────────────────
# Off by default for safety — flip to 'true' once you've eyeballed dev sends.
# Mints DPDP-compliant unsubscribe links via JWT_SECRET (HMAC).
LIFECYCLE_ENABLED=false
# Cron schedule — every 6h is a sensible default; the per-event-cap below
# keeps a single tick from blasting your SMTP if a backlog builds up.
LIFECYCLE_CRON=0 */6 * * *
LIFECYCLE_PER_EVENT_CAP=100

# ─── Agreement-feature billing (prepaid credits) ────────────────────────────
# First N agreements are free per photographer (lifetime). After that they buy
# prepaid credit packs; 1 credit is consumed when an agreement is SENT.
AGREEMENT_FREE_LIMIT=25
# Paywall kill-switch. true = charge from day 1; false = count usage but don't
# block at 0 (lets you watch usage before enabling enforcement).
AGREEMENT_BILLING_ENFORCE=true
# Credit packs (price in RUPEES). Packs stack. Defaults: 50/₹99, 200/₹299, 500/₹599.
AGREEMENT_PACK_1_CREDITS=50
AGREEMENT_PACK_1_PRICE=99
AGREEMENT_PACK_2_CREDITS=200
AGREEMENT_PACK_2_PRICE=299
AGREEMENT_PACK_3_CREDITS=500
AGREEMENT_PACK_3_PRICE=599
